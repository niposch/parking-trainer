<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParkingWeb)' == 'true'">
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);PARKING_WEB</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ParkingWeb)' == 'true'">
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
    <TrimmerRootAssembly Include="System.Runtime" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="exports/**/*.cs" />
    <Compile Remove="builds/**/*.cs" />
    <Compile Remove=".cache/**/*.cs" />
  </ItemGroup>
</Project>
